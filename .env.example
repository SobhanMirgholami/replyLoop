# Copy to .env for running on your computer. On Render, set these in the dashboard instead.

# Leave as is locally (a file called replyloop.db). On Render: your Supabase "Session pooler" URL.
DATABASE_URL=sqlite:///replyloop.db

# Any long random string. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Your first login (password: at least 10 characters). Change it in Settings after signing in.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# Meta app (only needed to go live with real accounts)
APP_SECRET=
VERIFY_TOKEN=

# Optional: AI replies when no automation matches
ANTHROPIC_API_KEY=

# Optional: Sign in with Google (README step 2e). Redirect URI locally: http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public address, only needed for a custom domain (Render's address is detected automatically)
PUBLIC_URL=

# Shown on the public /privacy page (Meta needs that page before an app can go Live)
PRIVACY_CONTACT=

# Backup comment checker (seconds between checks; 0 = off) and how many recent posts it checks
POLL_SECONDS=180
POLL_POSTS=5
